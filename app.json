{
  "expo": {
    "name": "שוקי",
    "slug": "shuky",
    "scheme": "shuky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8EE",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itaydalumi.shuky"
    },
    "android": {
      "package": "com.itaydalumi.shuky",
      "adaptiveIcon": {
        "backgroundColor": "#E85D3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "he",
      "name": "שוקי",
      "shortName": "שוקי",
      "description": "מה שנאפה בשכונה שלך – עוגות, עוגיות ומאפים ביתיים מהשכנים",
      "themeColor": "#E85D3F",
      "backgroundColor": "#FFF8EE"
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EE"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "כדי להעלות תמונה של המאפה שלך",
          "cameraPermission": "כדי לצלם את המאפה שלך"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "כדי להציג מאפים בסביבה. השכנים יראו רק מרחק משוער, אף פעם לא את הכתובת שלך."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E85D3F",
          "defaultChannel": "default"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
