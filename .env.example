# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API).
# Without a .env the app runs in demo mode on mock data.
# Use the public anon / publishable key only. NEVER put the service_role / secret key here:
# EXPO_PUBLIC_ variables are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
